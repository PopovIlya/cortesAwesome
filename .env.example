# Gemini API key (https://aistudio.google.com/apikey). Without it the app runs in demo mode.
GEMINI_API_KEY=
# Optional: gemma-4-26b-a4b-it (default, faster MoE) or gemma-4-31b-it
GEMINI_MODEL=gemma-4-26b-a4b-it
# Optional: unset = cloud with local fallback, "local" = Ollama only, "cloud" = no fallback
CORTES_BACKEND=
# Optional: local model in Ollama (default gemma4:e4b)
OLLAMA_MODEL=
# ElevenLabs key (elevenlabs.io → Developers → API Keys) for the whisper. Without it the macOS voice speaks.
ELEVENLABS_API_KEY=
# Optional: eleven_v3 (default, can whisper) or eleven_flash_v2_5 (faster, no whisper)
ELEVENLABS_MODEL=
# Optional: a voice ID per parliament member, from the ElevenLabs voice library
ELEVENLABS_VOICE_CAUTIOUS=
ELEVENLABS_VOICE_BOLD=
ELEVENLABS_VOICE_ACCOUNTANT=
ELEVENLABS_VOICE_DIPLOMAT=
ELEVENLABS_VOICE_CYNIC=
